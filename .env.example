# Broker the dashboard subscribes to. This has to be the WebSocket listener,
# not the plain 1883 MQTT port. Use wss when the page itself is served over HTTPS.
VITE_MQTT_PROTOCOL=ws
VITE_MQTT_HOST=192.168.1.10
VITE_MQTT_PORT=9001
VITE_MQTT_USER=pi5
VITE_MQTT_PASS=

# Topics. These must match the publisher's TOPIC_FAST / TOPIC_SLOW / TOPIC_CTRL.
VITE_TOPIC_FAST=pi5/fast
VITE_TOPIC_SLOW=pi5/slow
VITE_TOPIC_CTRL=pi5/control/pironman

# Optional display names for the services the publisher reports on, as
# comma-separated alias:Label pairs. Anything not listed here is shown
# capitalised, exactly as it arrives.
VITE_SERVICE_LABELS=mqtt:MQTT,adguard:AdGuard,f2b:Fail2ban

# rsync destination used by `npm run deploy`, in user@host:/path form.
# Point it at the directory nginx serves on your Pi.
DEPLOY_TARGET=user@host:/path/to/webroot/
