{
  "name": "pi5-dashboard",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vue-tsc/bin/vue-tsc.js -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "deploy": "npm run build && { T=\"${DEPLOY_TARGET:-$(grep -E '^DEPLOY_TARGET=' .env 2>/dev/null | tail -1 | cut -d= -f2-)}\"; rsync -av --delete dist/ \"${T:?set DEPLOY_TARGET in .env or pass it inline}\"; }"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "mqtt": "^5.15.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "^3.2.6",
    "workbox-window": "^7.4.1"
  }
}
